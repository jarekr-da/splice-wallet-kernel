-- | TokenRules for the private synchronizer.
--
-- This package is vetted on the PRIVATE synchronizer only.
-- It contains the factory contracts that mint, transfer, and allocate tokens.
-- By keeping this on the private sync, we minimize usage of the global synchronizer.
module Demo.TokenPrivate where

import DA.TextMap qualified as TextMap
import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.TransferInstructionV1

import Demo.TokenComposition


-- | Factory contract for managing token operations on the private synchronizer.
-- Implements TransferFactory (for direct transfers) and AllocationFactory (for trade allocations).
--
-- There should be one TokenRules contract per admin party on the private synchronizer.
template TokenRules
  with
    admin : Party
      -- ^ The registry admin party.
    instrumentId : Text
      -- ^ The instrument identifier managed by this factory.
  where
    signatory admin

    nonconsuming choice TokenRules_Mint : ContractId Token
      -- ^ Mint new tokens for a recipient.
      with
        recipient : Party
        amount : Decimal
      controller admin
      do
        create Token with
          owner = recipient
          admin
          instrumentId
          amount

    interface instance TransferFactory for TokenRules where
      view = TransferFactoryView with
        admin
        meta = Metadata with values = TextMap.empty

      transferFactory_transferImpl self TransferFactory_Transfer{..} = do
        -- Validate admin
        assertMsg "Expected admin does not match" (expectedAdmin == admin)
        -- Archive sender holdings and create receiver holdings
        -- For simplicity, we expect exactly one input holding
        let holdingCids = transfer.inputHoldingCids
        forA_ holdingCids (\hCid -> exercise (fromInterfaceContractId @Token hCid) Archive)
        receiverCid <- create Token with
          owner = transfer.receiver
          admin
          instrumentId
          amount = transfer.amount
        -- Return any change to sender if input was larger
        pure TransferInstructionResult with
          output = TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId receiverCid]
          senderChangeCids = []
          meta = emptyMetadata

      transferFactory_publicFetchImpl self TransferFactory_PublicFetch{..} = do
        assertMsg "Expected admin does not match" (expectedAdmin == admin)
        pure TransferFactoryView with
          admin
          meta = Metadata with values = TextMap.empty

    interface instance AllocationFactory for TokenRules where
      view = AllocationFactoryView with
        admin
        meta = Metadata with values = TextMap.empty

      allocationFactory_allocateImpl self AllocationFactory_Allocate{..} = do
        -- Validate admin
        assertMsg "Expected admin does not match" (expectedAdmin == admin)
        -- Archive input holdings
        forA_ inputHoldingCids (\hCid -> exercise (fromInterfaceContractId @Token hCid) Archive)
        -- Create the TokenAllocation
        allocCid <- create TokenAllocation with
          owner = allocation.transferLeg.sender
          admin
          instrumentId
          amount = allocation.transferLeg.amount
          allocation
        pure AllocationInstructionResult with
          output = AllocationInstructionResult_Completed with
            allocationCid = toInterfaceContractId allocCid
          senderChangeCids = []
          meta = emptyMetadata

      allocationFactory_publicFetchImpl self AllocationFactory_PublicFetch{..} = do
        assertMsg "Expected admin does not match" (expectedAdmin == admin)
        pure AllocationFactoryView with
          admin
          meta = Metadata with values = TextMap.empty
